#!/bin/bash
# scripts/post-commit — commit → push → build → package → replace .app → restart

set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
APP_NAME="KeyKeeper"

echo "====== 自动发布 ======"

# 1. Push
echo "==> push..."
cd "$PROJECT_DIR"
git push 2>&1 || echo "WARNING: push failed, continuing with local build"

# 2. Build release
echo "==> 编译 (swift build -c release)..."
swift build -c release

# 3. Package .app (reuse build-app.sh logic, but skip dmg for speed)
echo "==> 打包 .app..."
BUILD_DIR="$(swift build -c release --show-bin-path)"
APP_BUNDLE="$PROJECT_DIR/dist/dmg/${APP_NAME}.app"

rm -rf "$APP_BUNDLE"
mkdir -p "$APP_BUNDLE/Contents/MacOS"
mkdir -p "$APP_BUNDLE/Contents/Resources"

cat > "$APP_BUNDLE/Contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>KeyKeeperApp</string>
    <key>CFBundleIdentifier</key>
    <string>com.keykeeper.app</string>
    <key>CFBundleName</key>
    <string>KeyKeeper</string>
    <key>CFBundleVersion</key>
    <string>0.2.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.2.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
PLIST

echo -n "APPL????" > "$APP_BUNDLE/Contents/PkgInfo"
cp "$BUILD_DIR/KeyKeeperApp" "$APP_BUNDLE/Contents/MacOS/KeyKeeperApp"
cp "$BUILD_DIR/keykeeper" "$APP_BUNDLE/Contents/MacOS/keykeeper"
[ -f "$PROJECT_DIR/skill/keykeeper.md" ] && cp "$PROJECT_DIR/skill/keykeeper.md" "$APP_BUNDLE/Contents/Resources/keykeeper.md"

# 4. 退出当前运行的应用
echo "==> 退出 ${APP_NAME}..."
killall KeyKeeperApp 2>/dev/null || true
sleep 1

# 5. 替换 /Applications
echo "==> 替换 /Applications/${APP_NAME}.app..."
rm -rf "/Applications/${APP_NAME}.app"
cp -R "$APP_BUNDLE" "/Applications/${APP_NAME}.app"

# ad-hoc 签名 + 清 quarantine（防 LaunchServices kLSNoExecutableErr，2026-07-05/06 两次翻车）
xattr -cr "/Applications/${APP_NAME}.app" 2>/dev/null || true
codesign --force --deep -s - "/Applications/${APP_NAME}.app"

# 6. 更新 CLI，并确认实际部署版本
EXPECTED_CLI_VERSION="$("$BUILD_DIR/keykeeper" --version)"
if ! cp "$BUILD_DIR/keykeeper" /usr/local/bin/keykeeper; then
    echo "ERROR: /usr/local/bin CLI 未更新（需手动 sudo cp），当前 PATH 上是旧版" >&2
fi
if ! "$PROJECT_DIR/scripts/verify-cli-deploy.sh" \
    "$BUILD_DIR/keykeeper" \
    "$EXPECTED_CLI_VERSION"; then
    echo "WARNING: App 已更新，但 CLI 部署版本不一致；请手动更新 /usr/local/bin/keykeeper" >&2
fi

# 7. 重新启动
echo "==> 启动 ${APP_NAME}..."
open "/Applications/${APP_NAME}.app"

echo "==> 完成"
