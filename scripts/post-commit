#!/bin/bash
# scripts/post-commit — commit → push → package once → replace CLI and app → restart

set -euo pipefail
PROJECT_DIR="$(git rev-parse --show-toplevel)"
APP_NAME="KeyKeeper"
APP_BUNDLE="$PROJECT_DIR/dist/dmg/${APP_NAME}.app"

echo "====== 自动发布 ======"
echo "==> push..."
git -C "$PROJECT_DIR" push 2>&1 || echo "WARNING: push failed, continuing with local build"

"$PROJECT_DIR/scripts/build-app.sh" --skip-dmg

echo "==> 更新 CLI..."
"$PROJECT_DIR/scripts/install-cli.sh" \
    "$APP_BUNDLE/Contents/MacOS/keykeeper" \
    "/opt/homebrew/bin/keykeeper"

echo "==> 退出 ${APP_NAME}..."
killall KeyKeeperApp 2>/dev/null || true
sleep 1

echo "==> 替换 /Applications/${APP_NAME}.app..."
rm -rf "/Applications/${APP_NAME}.app"
ditto "$APP_BUNDLE" "/Applications/${APP_NAME}.app"
codesign --verify --deep --strict --verbose=2 "/Applications/${APP_NAME}.app"

echo "==> 启动 ${APP_NAME}..."
open "/Applications/${APP_NAME}.app"
echo "==> 完成"
